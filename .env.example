# Copy to .env. Local defaults shown; see backend/app/core/config.py for every option.
APP_ENV=local                     # local | test | staging | production
DATABASE_URL=postgresql+asyncpg://cfa_lms:cfa_lms_local@localhost:5432/cfa_lms
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false               # must be true outside local/test
OTP_DEBUG_ECHO=true               # shows OTP codes on screen; must be false outside local/test
STAFF_MFA_REQUIRED=false          # must be true outside local/test
SMS_PROVIDER=console              # console | msg91 (adapter added with cloud deployment)
EMAIL_PROVIDER=console            # console | ses

# Payments: mock (local test gateway) or razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: forward domain events (payments.order_paid, ...) to another service
EVENT_SINK_URL=
