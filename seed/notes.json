              "type": "callout",
              "variant": "example",
              "title": "Worked example",
              "inline": [
                {
                  "t": "Ritu wants ₹20 lakh for a workshop. She sells shares to investors in the primary market. Later, the investors trade those shares among themselves in the secondary market. Ritu's company receives money only from the first sale."
                }
              ]
